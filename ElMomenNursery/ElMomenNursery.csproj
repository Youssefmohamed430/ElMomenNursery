<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ElMomenNursery.Application\ElMomenNursery.Application.csproj" />
    <ProjectReference Include="..\ElMomenNursery.Infrastructure\ElMomenNursery.Infrastructure.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>نظام إدارة حضانة المؤمن</AssemblyName>
    <Product>نظام إدارة حضانة المؤمن</Product>
    <ApplicationIcon>Resources\Branding\AlMoumenNursery.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Update="Resources\Branding\AlMoumenNurseryLogo.jpeg" CopyToOutputDirectory="PreserveNewest" />
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="appsettings.Development.json" CopyToOutputDirectory="PreserveNewest" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.10" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.10" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="9.0.2" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>
  <Target Name="CopyQuestPdfDefaultFontArchive" AfterTargets="Publish">
    <Copy SourceFiles="$(NuGetPackageRoot)questpdf\2026.9.2\questpdf_fonts_lato.br"
          DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true"
          Condition="Exists('$(NuGetPackageRoot)questpdf\2026.9.2\questpdf_fonts_lato.br')" />
  </Target>
</Project>




