{
  "Printer": {
    "Name": "",
    "PaperWidthMm": 80,
    "PaperHeightMm": 297,
    "FontName": "Arial",
    "FontSize": 12,
    "AutoCut": true
  },
  "Authentication": {
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 15
  },
  "LocalData": {
    "DirectoryPath": "%LOCALAPPDATA%\\AlMoumenNursery"
  },
  "ConnectionStrings": {
    "Nursery": "Data Source=%LOCALAPPDATA%\\AlMoumenNursery\\nursery.db;Foreign Keys=True;Default Timeout=30"
  },
  "Serilog": {
    "Using": [ "Serilog", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "File": {
      "Path": "Logs/log-.txt",
      "RetainedFileCountLimit": 31,
      "FileSizeLimitBytes": 10485760
    }
  }
}
