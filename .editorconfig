root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true

[*.{cs,csx}]
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{csproj,props,targets,sln}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = true
